{
	"name": "leget-main",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run check:forms && npm run check:goals && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"check:typography": "node ../../scripts/check-heading-typography.mjs",
		"check:images": "node ../../scripts/check-component-images.mjs",
		"check:phone": "node scripts/check-site-phone.mjs",
		"check:ds-tokens": "node scripts/check-ds-tokens.mjs",
		"lint": "npm run check:forms && npm run check:goals && npm run check:component-controls && npm run check:typography && npm run check:images && npm run check:phone && npm run check:ds-tokens && npm run check:rich-text && prettier --check .",
		"format": "prettier --write .",
		"check:rich-text": "node scripts/check-rich-text.mjs",
		"check:component-controls": "node scripts/check-component-controls.mjs",
		"test:component-images": "node --experimental-strip-types --test scripts/test-component-images.mjs",
		"check:goals": "node scripts/goals-catalog.mjs",
		"goals:generate": "node scripts/goals-catalog.mjs --write",
		"test:goals": "node scripts/test-goals.mjs",
		"test:metrika": "node --test scripts/test-metrika.mjs",
		"test:captcha": "node --test scripts/test-smartcaptcha.mjs",
		"check:forms": "node scripts/check-forms.mjs",
		"test:forms": "node scripts/test-form-submission.mjs",
		"test:lead-catcher": "node scripts/test-lead-catcher.mjs",
		"test:remember": "node --test scripts/test-remember-me.mjs && node scripts/test-remember-session.mjs",
		"test:publication": "node --test scripts/test-page-publication.mjs scripts/test-analytics-lifecycle.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^25.6.0",
		"@types/sanitize-html": "^2.16.1",
		"@types/three": "^0.186.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"subset-font": "^2.5.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.3",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@google/model-viewer": "^4.3.1",
		"@tiptap/core": "^3.31.3",
		"@tiptap/pm": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"cropperjs": "^1.6.2",
		"graphql-request": "^7.4.0",
		"gsap": "^3.15.0",
		"runed": "^0.37.1",
		"sanitize-html": "^2.17.7",
		"three": "^0.183.2"
	},
	"overrides": {
		"cookie": "^0.7.0"
	}
}
